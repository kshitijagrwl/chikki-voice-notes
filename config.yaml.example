recording:
  sample_rate: 16000
  channels: 1
  format: wav
  max_duration_minutes: 120
  recordings_dir: recordings
  # Capture system audio (Zoom/Meet/Slack) alongside the mic via the
  # chikki-syscap helper (ScreenCaptureKit). Requires Screen Recording
  # permission. When false, only the mic is recorded.
  system_audio: false
  # mono = sum mic+system into a single channel for transcription (default).
  # A stereo archive (L=mic, R=system) is always written alongside.
  mix_mode: mono

transcription:
  # Active engine: whisper | indicwhisper | parakeet
  engine: whisper
  language: en

  engines:
    whisper:
      model: mlx-community/whisper-large-v3-turbo
      description: "General-purpose, 99 languages, good Indian English"

    indicwhisper:
      model: ai4bharat/indicwhisper-large-v2
      description: "Fine-tuned for Indian languages + Indian English, best for Hindi-English code-switching"

    parakeet:
      model: senstella/parakeet-mlx
      description: "10x faster than Whisper, better noise robustness, English-only"

diarization:
  # Speaker diarization (pyannote/speaker-diarization-3.1). Requires a
  # HuggingFace token in `.env` as HF_TOKEN, and acceptance of the model
  # EULA at https://huggingface.co/pyannote/speaker-diarization-3.1.
  # When enabled, transcript segments are labeled Speaker A, B, C…
  enabled: false
  # Optional hard constraints on the diarizer. null = auto-detect.
  min_speakers: null
  max_speakers: null
  # Speaker identification: match diarization clusters against enrolled
  # speakers in speakers/registry.json. When true and the registry is
  # non-empty, anonymous labels (A, B, C…) are replaced with real names.
  # Enroll speakers with: python -m src.cli enroll <name> <audio.wav>
  identify: true
  # Cosine similarity threshold for a match (0.0–1.0). Lower = more lenient.
  match_threshold: 0.7

processing:
  # LLM provider: gemini | openai | anthropic
  provider: gemini
  # Model name for the chosen provider. Examples:
  #   gemini:    gemini-2.5-flash, gemini-2.0-flash
  #   openai:    gpt-4o, gpt-4o-mini
  #   anthropic: claude-opus-4-6, claude-sonnet-4-6
  model: gemini-2.5-flash
  temperature: 0.3
  # Default meeting type (run: python -m src.cli types)
  default_type: default
  # Prepend Hinglish transliteration-correction instructions before extraction
  fix_hinglish: true

output:
  notes_dir: notes
  template: default

menubar:
  hotkey: command+shift+r
  show_timer: true
  sound_on_start: true
  sound_on_stop: true
